      "seed": 1250011478,
      "version": 472,
      "versionNonce": 788155338,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783264042468,
      "link": null,
      "locked": false,
      "text": "1. use \"serde-json\" to read: DB info, allowed origins, listener port, etc.\n2. use \"axum\" to start the server and receive POST data, which is then saved in a struct\n3. save the received data in the database to store for later use\n4. validate the data\n5. return result to the server",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. use \"serde-json\" to read: DB info, allowed origins, listener port, etc.\n2. use \"axum\" to start the server and receive POST data, which is then saved in a struct\n3. save the received data in the database to store for later use\n4. validate the data\n5. return result to the server",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
