    {
      "id": "NEmrAwpIYx8N6bzh8F2LS",
      "type": "text",
      "x": 840.5515873015863,
      "y": 2347.2182539682535,
      "width": 1591.183349609375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
